# Aplicacao
NODE_ENV=development
PORT=3333

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=medclinic
DB_LOGGING=false

# Seguranca
JWT_SECRET=troque-esta-chave-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Seed do administrador inicial
ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=admin@medclinic.com
ADMIN_PASSWORD=Admin@123
