# Aplicacao
NODE_ENV=development
PORT=3333
RUN_MIGRATIONS=true

# Banco de dados (PostgreSQL)
# em producao use DATABASE_URL (Neon/Render); localmente pode usar as DB_* separadas
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=medclinic
DB_LOGGING=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Seguranca
JWT_SECRET=
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=10

# Seed do administrador inicial
ADMIN_NAME=Administrador do Sistema
ADMIN_EMAIL=admin@medclinic.com
ADMIN_PASSWORD=
