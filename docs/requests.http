@baseUrl = http://localhost:3333
@adminToken = COLE_AQUI_O_TOKEN_DO_ADMIN
@atendenteToken = COLE_AQUI_O_TOKEN_DO_ATENDENTE

### Health check
GET {{baseUrl}}/health

### Cadastro
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Maria Atendente",
  "email": "maria@medclinic.com",
  "password": "Senha@123"
}

### Cadastro com e-mail repetido
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Maria Atendente",
  "email": "maria@medclinic.com",
  "password": "Senha@123"
}

### Cadastro com dados invalidos
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Jo",
  "email": "email-invalido",
  "password": "123"
}

### Login admin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@medclinic.com",
  "password": "Admin@123"
}

### Login atendente
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@medclinic.com",
  "password": "Senha@123"
}

### Login com senha errada
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@medclinic.com",
  "password": "senha-errada"
}

### Meu perfil
GET {{baseUrl}}/users/me
Authorization: Bearer {{atendenteToken}}

### Meu perfil sem token
GET {{baseUrl}}/users/me

### Token invalido
GET {{baseUrl}}/users/me
Authorization: Bearer token.invalido.aqui

### Admin ping com ADMIN
GET {{baseUrl}}/admin/ping
Authorization: Bearer {{adminToken}}

### Admin ping com ATENDENTE
GET {{baseUrl}}/admin/ping
Authorization: Bearer {{atendenteToken}}

### Rota que nao existe
GET {{baseUrl}}/rota-que-nao-existe
